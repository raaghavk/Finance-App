# Notion internal integration token (read Expenses). Never commit the real value.
NOTION_TOKEN=

# Optional alias for NOTION_TOKEN
# NOTION_API_KEY=

# Expenses data source (preferred)
NOTION_EXPENSES_DATA_SOURCE_ID=b35c3e74-0bc7-432d-8309-80a7583d3601

# Expenses database id (fallback if data-source query is unavailable)
NOTION_EXPENSES_DATABASE_ID=76941781c8ef4d258923b9c2a6750292

# Accounts data source (optional; defaults match the Notion DB)
NOTION_ACCOUNTS_DATA_SOURCE_ID=2c0de472-1d21-4243-bcd8-1fb19ab89bba
NOTION_ACCOUNTS_DATABASE_ID=a9effaa05c66492a9780b5a36cda1d63

# Budgets data source (optional; defaults match the Notion DB)
NOTION_BUDGETS_DATA_SOURCE_ID=3f8d31df-d13d-49a2-a9ac-f5b8489f737f
NOTION_BUDGETS_DATABASE_ID=301bb78c3c094fb1aee38bcb57f7beb0

# Set to 1 to force example data for all Notion reads
# NOTION_EXPENSES_USE_MOCK=1
# NOTION_USE_MOCK=1

# Sarvam Speech-to-Text (Saaras). REST https://api.sarvam.ai/speech-to-text
# Header: api-subscription-key. Model: saaras:v3. Clips under 30s.
# SARVAM_API_KEY=
# SARVAM_API_SUBSCRIPTION_KEY=

# Google Cloud Vision DOCUMENT_TEXT_DETECTION (free tier, not Document AI).
# Use an API key for images:annotate. GOOGLE_APPLICATION_CREDENTIALS is not read.
# GOOGLE_CLOUD_VISION_API_KEY=
# GOOGLE_VISION_API_KEY=
